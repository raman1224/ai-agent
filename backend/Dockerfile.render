FROM node:22-alpine
WORKDIR /app

# shared ( Dockerfile to layout two join two place)
COPY shared ./shared
COPY shared ./gateway/shared

# ---------- GATEWAY ----------
WORKDIR /app/gateway
COPY gateway/package*.json ./
RUN npm ci
COPY gateway/ ./
RUN chmod -R +x node_modules/.bin && npm run build

# ---------- AUTH ----------
WORKDIR /app/services/auth
COPY services/auth/package*.json ./
RUN npm ci
COPY services/auth/ ./
RUN chmod -R +x node_modules/.bin && npm run build

# ---------- CHAT ----------
WORKDIR /app/services/chat
COPY services/chat/package*.json ./
RUN npm ci
COPY services/chat/ ./
RUN chmod -R +x node_modules/.bin && npm run build

# ---------- AGENT ----------
WORKDIR /app/services/agent
COPY services/agent/package*.json ./
RUN npm ci
COPY services/agent/ ./
RUN chmod -R +x node_modules/.bin && npm run build

# ---------- START ----------
WORKDIR /app
COPY start.sh ./start.sh
RUN sed -i 's/\r$//' start.sh && chmod +x start.sh

ENV NODE_ENV=production
EXPOSE 8000
CMD ["./start.sh"]